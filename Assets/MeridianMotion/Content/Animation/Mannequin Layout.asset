  states:
  - name: Locomotion
    note: 'Each loop at the speed its strides are made for (measured on the mannequin), so its planted feet stay put there, from walking to sprinting; past the fastest loop''s own speed, the translator plays it faster to match (Locomotion Playback, from the top speed this sets: see AnimatorParameterTranslator''s Playback). No Foot IK on any state: on a model stretched along one axis, Unity''s Foot IK puts the feet where it reports their goals, which is off by the stretch (see CharacterUtilities.AnimatedIKGoalPosition). Foot placement plants them at the goals, corrected, instead.'
    motions:
    - motion: tree:Locomotion
      note: 
      speed:
        kind: 0
        constant: 0
        clip: 
        direction: {x: 0, y: 0}
        multiply: 0
        reciprocal: 0
        lerp: 0
        lerpTo: 0
        hasFallback: 0
        fallback: 0
        minimum: 0
      speedParameter: LocomotionPlayback
      timeParameter: 
      cycleOffset:
        kind: 0
        constant: 0
        clip: 
        direction: {x: 0, y: 0}
        multiply: 0
        reciprocal: 0
        lerp: 0
        lerpTo: 0
        hasFallback: 0
        fallback: 0
        minimum: 0
      parameters:
      - name: LocomotionPlayback
        note: 
        type: 1
        defaultBool: 0
        defaultFloat:
          kind: 0
          constant: 1
          clip: 
          direction: {x: 0, y: 0}
          multiply: 0
          reciprocal: 0
          lerp: 0
          lerpTo: 0
          hasFallback: 0
          fallback: 0
          minimum: 0
        requires:
          clips: []
          missingClips: []
          states: []
          missingStates: []
      - name: LocomotionTopSpeed
        note: 
        type: 1
        defaultBool: 0
        defaultFloat:
          kind: 1
          constant: 0
          clip: Sprint Loop
          direction: {x: 0, y: 0}
          multiply: 0
          reciprocal: 0
          lerp: 0
          lerpTo: 0
          hasFallback: 0
          fallback: 0
          minimum: 0
        requires:
          clips: []
          missingClips: []
          states: []
          missingStates: []
      requires:
        clips: []
        missingClips: []
        states: []
        missingStates: []
    requires:
      clips: []
      missingClips: []
      states: []
