  blendTrees:
  - name: Locomotion
    note: 'Idle, then each loop at the speed its strides are made for, offset to land its left foot at the same moment as the others, so blending between them never mixes one foot''s stride with the other''s. The libraries'' walk is slow and their jog (what sprinting shows) quick: the mannequin''s brisk walk and run fill the speeds between.'
    type: 0
    parameter: Speed
    parameterY: 
    children:
    - motion: Idle
      note: 
      threshold:
        kind: 0
        constant: 0
        clip: 
        direction: {x: 0, y: 0}
        multiply: 0
        reciprocal: 0
        lerp: 0
        lerpTo: 0
        hasFallback: 0
        fallback: 0
        minimum: 0
      position: {x: 0, y: 0}
      positionScale:
        kind: 0
        constant: 0
        clip: 
        direction: {x: 0, y: 0}
        multiply: 0
        reciprocal: 0
        lerp: 0
        lerpTo: 0
        hasFallback: 0
        fallback: 0
        minimum: 0
      timeScale: 1
