        direction: {x: 0, y: 0}
        multiply: 0
        reciprocal: 0
        lerp: 0
        lerpTo: 0
        hasFallback: 0
        fallback: 0
        minimum: 0
      requires:
        clips: []
        missingClips: []
        states: []
        missingStates: []
