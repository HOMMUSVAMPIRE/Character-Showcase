  m_Script: {fileID: 11500000, guid: baa6d5b3ec5140868a275394ef40cc1a, type: 3}
  m_Name: Generic Rig Layout
  m_EditorClassIdentifier: MeridianMotion.Characters::MeridianMotion.Characters.AnimatorLayout
  controller: {fileID: 0}
  measuringModel: {fileID: 0}
  ikPass: 0
  onlyForSets: 1
  defaultState: Locomotion
  notes: 'The starting point for a generic-rig character''s animation set (a generic-rig character''s own clips in its roles: see docs/generic-rigs.md). Its states and transitions are the fox''s (Fox Layout.asset), its slots empty: an animation set that starts from it fills them with the generic-rig character''s clips. Only Idle is needed: a role left empty plays its fallback''s clip (Run plays the Walk, Sprint the Run, the crouches, swims and jumps the Idle or Walk), and with no Turn Step the generic-rig character stands still turning. Its Speed thresholds (Walk, Run, Sprint, Swim) are the fox''s speeds: for a generic-rig character whose clips are made for other speeds, copy this layout, set them to those speeds (as fast as each clip''s feet keep to the ground) and start its set from the copy. No IK pass: paw placement (LegPlacementIK) runs after the Animator. Only For Sets: it''s never built by itself.'
  clips:
  - name: Turn Step
    candidates: []
    fallbackSlot: 
  - name: Idle
    candidates: []
    fallbackSlot: 
  - name: Walk
    candidates: []
    fallbackSlot: Idle
  - name: Run
    candidates: []
    fallbackSlot: Walk
  - name: Sprint
    candidates: []
    fallbackSlot: Run
  - name: Crouch Idle
    candidates: []
    fallbackSlot: Idle
  - name: Crouch Walk
    candidates: []
    fallbackSlot: Walk
  - name: Jump Fall
    candidates: []
    fallbackSlot: Jump Rise
