        },
        "length": {
          "type": "number"
        },
        "number": {
          "type": ["string", "null"],
          "default": null
        }
      },
      "required": ["piece", "parent", "wallPoint", "outward", "top", "length"],
      "additionalProperties": false
    },
    "piece.Block": {
      "type": "object",
      "properties": {
