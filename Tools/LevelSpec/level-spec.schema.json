        },
        "bottom": {
          "type": "number"
        },
        "facing": {
          "$ref": "#/$defs/point2"
        },
        "number": {
          "type": ["string", "null"]
        },
        "name": {
          "type": ["string", "null"]
        },
        "freeStanding": {
          "type": "boolean",
          "default": false
        }
      },
      "required": ["piece", "parent", "at", "bottom", "facing", "number", "name"],
      "additionalProperties": false
    },
    "piece.Banner": {
