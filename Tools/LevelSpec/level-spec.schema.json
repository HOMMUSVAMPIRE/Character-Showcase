        },
        "x1": {
          "type": "number"
        },
        "z0": {
          "type": "number"
        },
        "z1": {
          "type": "number"
        },
        "y0": {
          "type": "number"
        },
        "y1": {
          "type": "number"
        },
        "surface": {
          "$ref": "#/$defs/surface",
          "default": "Concrete"
        }
      },
      "required": ["piece", "parent", "name", "x0", "x1", "z0", "z1", "y0", "y1"],
      "additionalProperties": false
    },
    "piece.Bollard": {
      "type": "object",
      "properties": {
        "piece": {
          "const": "Bollard"
        },
        "parent": {
          "$ref": "#/$defs/path"
