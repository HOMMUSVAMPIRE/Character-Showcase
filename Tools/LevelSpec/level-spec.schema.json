                "$ref": "#/$defs/point2"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "required": ["piece", "parent", "shape", "floor"],
      "additionalProperties": false
    },
    "piece.BouncePad": {
      "type": "object",
      "properties": {
        "piece": {
