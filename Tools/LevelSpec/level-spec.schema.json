{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character Showcase level spec",
  "description": "A level as the Graybox pieces it's built from, in order (see LevelSpec). Written by LevelSpecTools from the pieces' parameters: regenerate it, don't edit it.",
  "type": "object",
  "properties": {
    "format": {
      "const": "character-showcase-level"
    },
    "version": {
      "type": "integer",
      "maximum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "scene": {
      "type": "string",
      "pattern": "^Assets/.+\\.unity$"
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      }
    }
  },
  "required": ["format", "name", "scene", "parts"],
  "additionalProperties": false,
  "$defs": {
    "point2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "A point on the ground plane: [x, z], metres, +z north."
    },
    "point3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "A point or size: [x, y, z], metres."
    },
    "area": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "An area on the ground plane: [xMin, zMin, xMax, zMax], metres."
    },
    "path": {
      "type": "string",
      "description": "A parent: its path under the level's root, names separated by '/' ('' is the root), '#n' after the nth (from 2) child with the same name."
    },
    "random": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "integer"
        }
      },
      "required": ["seed"],
      "additionalProperties": false,
      "description": "A random number generator, by its seed."
    },
    "cell": {
      "type": "object",
      "description": "A room or passage of an enclosed network (Graybox.Cells): its area, floor and ceiling heights, and whether it's open above.",
      "properties": {
        "name": {
          "type": "string"
        },
        "x0": {
          "type": "number"
        },
        "z0": {
          "type": "number"
        },
        "x1": {
          "type": "number"
        },
        "z1": {
          "type": "number"
        },
        "floor": {
          "type": "number"
        },
        "ceiling": {
          "type": "number"
        },
        "open": {
          "type": "boolean"
        }
      },
      "required": ["x0", "z0", "x1", "z1", "floor", "ceiling"],
      "additionalProperties": false
    },
    "surface": {
      "enum": ["Concrete", "Panel", "Ground", "Graphite", "Steel", "Accent", "Light", "Cyan", "White", "Foliage", "Soil", "Grass"]
    },
    "piece.State": {
      "type": "object",
      "properties": {
        "piece": {
          "const": "State"
        },
        "stepRise": {
          "type": "number"
        },
        "stepRun": {
          "type": "number"
        },
        "bridgeLength": {
          "type": "number"
        },
        "deck": {
          "type": "number"
        },
        "railHeight": {
          "type": "number"
        },
        "railThickness": {
          "type": "number"
        }
      },
      "required": ["piece"],
      "additionalProperties": false,
      "description": "Sets the stairs' step size and the decks' and rails' dimensions for the pieces after it in its part."
    },
    "piece.AccentPost": {
      "type": "object",
      "properties": {
        "piece": {
          "const": "AccentPost"
        },
        "parent": {
          "$ref": "#/$defs/path"
        },
        "at": {
          "$ref": "#/$defs/point2"
        },
        "height": {
          "type": "number"
        }
      },
      "required": ["piece", "parent", "at", "height"],
      "additionalProperties": false
    },
    "piece.AreaSign": {
      "type": "object",
      "properties": {
