Assets/Animation/CMU/**/*.fbx filter=lfs diff=lfs merge=lfs -text
Assets/Animation/Quaternius/**/*.fbx filter=lfs diff=lfs merge=lfs -text

# Character models and their textures: large binaries (some generated, some imported).
Assets/Models/**/*.fbx filter=lfs diff=lfs merge=lfs -text
Assets/Models/**/*.png filter=lfs diff=lfs merge=lfs -text

# Level scenes and their baked data: generated by the level builders and recommitted whole on every rebuild (tens of
# MB each), so they're kept out of git's history. Their small hand-edited neighbours (post-processing profiles,
# materials, lighting settings, notes) stay as text.
Assets/Scenes/**/*.unity filter=lfs diff=lfs merge=lfs -text
Assets/Scenes/**/*.exr filter=lfs diff=lfs merge=lfs -text
Assets/Scenes/**/LightingData.asset filter=lfs diff=lfs merge=lfs -text
Assets/Scenes/**/OcclusionCullingData.asset filter=lfs diff=lfs merge=lfs -text
